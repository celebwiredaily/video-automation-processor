# Secrets - never commit these
.env
.env.*
*.env
service_account*.json
*service-account*.json
credentials.json
gcp-*.json
token*.json
token.pickle
gdrive_token.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Pipeline working artefacts.
# NOTE: build/ is the pipeline work dir inside each project, but the packaging
# build dir at the repo root also matches, so both are ignored.
**/build/segments/
**/build/logs/
**/build/fonts/
**/build/visuals.mp4
**/build/captions.ass
**/build/plan.json
**/build/concat.txt

# Rendered output and diagnostics are regenerable.
**/output/*.mp4
**/output/diagnostics/

# Large media staged locally (fetched by `video_pipeline fetch`).
**/assets/*.mp4
**/assets/*.mov
**/assets/*.mkv
**/assets/*.webm
**/assets/*.jpg
**/assets/*.jpeg
**/assets/*.png
**/assets/*.webp
**/assets/*.wav
**/assets/*.mp3
**/assets/*.m4a
**/assets/*.aac
**/assets/*.flac

# Media at the repository root (the ~59 MB reference video) stays out of git.
*.mp4

# Generated example/test projects: keep the editable project *definition*
# (project.yaml, timeline.yaml, config.yaml, script.md, captions) but never the
# media it points at, which is regenerated by
# tools/build_example_project.py or `prepare-test`.
examples/*/assets/
examples/*/audio/
examples/*/output/
examples/*/build/
test_project/

*.log